# ==============================================================================
# Telegram Task Tracker Bot & Mini App - Environment Configuration
# ==============================================================================

# Telegram Bot Token obtained from @BotFather (Required)
# Example: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_bot_token_from_botfather

# Google Gemini API Key for NLP task extraction (Optional / Recommended)
# Example: AIzaSy...
GEMINI_API_KEY=your_gemini_api_key

# SQLAlchemy Database URL (SQLite with aiosqlite driver)
# For local development: sqlite+aiosqlite:///tasks.db
# For Docker Compose: sqlite+aiosqlite:////app/data/tasks.db
DATABASE_URL=sqlite+aiosqlite:///tasks.db

# Telegram Mini App Public HTTPS URL (Optional)
# In production or development with tunnels (e.g., https://your-domain.com or ngrok URL).
# If omitted or empty, the bot falls back to http://{HOST}:{PORT}.
WEBAPP_URL=https://your-mini-app-domain.com

# Server / API Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False
